{
  "name": "@kenyaemr/esm-shr-app",
  "version": "5.4.4",
  "description": "Patient care panels microfrontend for the OpenMRS SPA",
  "keywords": [
    "openmrs"
  ],
  "homepage": "https://github.com/palladiumkenya/kenyaemr-esm-core#readme",
  "bugs": {
    "url": "https://github.com/palladiumkenya/kenyaemr-esm-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palladiumkenya/kenyaemr-esm-core#readme"
  },
  "license": "MPL-2.0",
  "main": "src/index.ts",
  "source": true,
  "browser": "dist/kenyaemr-esm-shr-app.js",
  "scripts": {
    "analyze": "rspack build --mode=production --analyze",
    "build": "rspack --mode=production",
    "coverage": "yarn --cwd ../.. vitest run packages/esm-shr-app/src --coverage --coverage.include='packages/esm-shr-app/src/**/*.component.tsx'",
    "debug": "npm run serve",
    "extract-translations": "i18next 'src/**/*.component.tsx' 'src/index.ts' --config ../../tools/i18next-parser.config.js",
    "lint": "eslint src --ext ts,tsx",
    "serve": "rspack serve --mode=development",
    "start": "openmrs develop",
    "test": "yarn --cwd ../.. vitest run packages/esm-shr-app/src",
    "test:watch": "yarn --cwd ../.. vitest packages/esm-shr-app/src",
    "typescript": "tsc"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "dependencies": {
    "lodash-es": "^4.17.15",
    "react-otp-input": "^3.1.1",
    "react-to-print": "2.14.13"
  },
  "peerDependencies": {
    "@carbon/react": "1.x",
    "@openmrs/esm-framework": "9.x",
    "react": "^18.1.0",
    "react-i18next": "11.x",
    "react-router-dom": "6.x"
  },
  "publishConfig": {
    "access": "public"
  }
}
